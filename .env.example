# Database Configuration
POSTGRES_DB=puresky_db
POSTGRES_USER=puresky
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Django Configuration
DJANGO_SECRET_KEY=your-django-secret-key-change-this-in-production
DJANGO_DEBUG=True
DATABASE_URL=postgresql://puresky:your_secure_password_here@db:5432/puresky_db

# Mobile App Configuration
# Use your local IP address for testing on physical devices
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
EXPO_PUBLIC_API_URL=http://localhost:8000/api